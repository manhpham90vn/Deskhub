default_platform(:ios)

APP_IDENTIFIER = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
EXTENSION_IDENTIFIER = "#{APP_IDENTIFIER}.broadcast".freeze
TEAM_ID = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
APP_VERSION = File.read(File.expand_path("../../../VERSION", __dir__)).strip
MATCH_PROFILE = "match AppStore #{APP_IDENTIFIER}".freeze
MATCH_EXTENSION_PROFILE = "match AppStore #{EXTENSION_IDENTIFIER}".freeze
SIGNED_TARGETS = {
  "app" => [APP_IDENTIFIER, MATCH_PROFILE],
  "broadcast" => [EXTENSION_IDENTIFIER, MATCH_EXTENSION_PROFILE]
}.freeze

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: true
  )
end

platform :ios do
  desc "Create/update the cert + profile in the match repo (run by hand on first setup or when the cert expires)"
  lane :certificates do
    match(type: "appstore", api_key: asc_api_key, readonly: false)
  end

  desc "Build a Release ipa (signed with match) and upload to TestFlight"
  lane :release do
    api_key = asc_api_key

    setup_ci if ENV["CI"]

    match(type: "appstore", api_key: api_key, readonly: ENV["CI"] ? true : false)

    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    SIGNED_TARGETS.each do |target, (bundle_id, profile)|
      update_code_signing_settings(
        path: "Deskhub.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        bundle_identifier: bundle_id,
        code_sign_identity: "Apple Distribution",
        profile_name: profile
      )
    end

    xcargs = "DEVELOPMENT_TEAM=#{TEAM_ID} " \
             "MARKETING_VERSION=#{APP_VERSION} " \
             "CURRENT_PROJECT_VERSION=#{build_number}"

    build_app(
      project: "Deskhub.xcodeproj",
      scheme: "app",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      xcargs: xcargs,
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => MATCH_PROFILE,
          EXTENSION_IDENTIFIER => MATCH_EXTENSION_PROFILE
        }
      }
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Push the store listing (fastlane/metadata + fastlane/screenshots) to App Store Connect"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_version: APP_VERSION,
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
