{
  "version": 6,
  "configurePresets": [
    {
      "name": "x64-debug",
      "displayName": "x64 Debug (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DESKHUB_WERROR": "ON"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release (Ninja)",
      "inherits": "x64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "arm64-debug",
      "displayName": "arm64 Debug (Ninja)",
      "inherits": "x64-debug",
      "architecture": { "value": "arm64", "strategy": "external" }
    },
    {
      "name": "arm64-release",
      "displayName": "arm64 Release (Ninja)",
      "inherits": "arm64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "ASan + UBSan (Ninja)",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "DESKHUB_LINUX_APP": "OFF"
      }
    },
    {
      "name": "asan-msvc",
      "displayName": "ASan (MSVC, Ninja)",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc /fsanitize=address /Zi",
        "DESKHUB_LINUX_APP": "OFF",
        "DESKHUB_WINDOWS_APP": "OFF",
        "DESKHUB_WERROR": "OFF"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan (Ninja)",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "DESKHUB_LINUX_APP": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (clang + llvm-cov)",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "DESKHUB_LINUX_APP": "OFF",
        "DESKHUB_QUIC": "OFF",
        "DESKHUB_AUDIO": "OFF"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer + ASan + UBSan (clang)",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "DESKHUB_FUZZ": "ON",
        "DESKHUB_LINUX_APP": "OFF",
        "DESKHUB_QUIC": "OFF",
        "DESKHUB_AUDIO": "OFF"
      }
    },
    {
      "name": "fuzz-coverage",
      "displayName": "Fuzz corpus coverage (clang + llvm-cov)",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link -fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "DESKHUB_FUZZ": "ON",
        "DESKHUB_LINUX_APP": "OFF",
        "DESKHUB_QUIC": "OFF",
        "DESKHUB_AUDIO": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug" },
    { "name": "x64-release", "configurePreset": "x64-release" },
    { "name": "arm64-debug", "configurePreset": "arm64-debug" },
    { "name": "arm64-release", "configurePreset": "arm64-release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "asan-msvc", "configurePreset": "asan-msvc" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "fuzz-coverage", "configurePreset": "fuzz-coverage" }
  ]
}
