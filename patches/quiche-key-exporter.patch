+#[no_mangle]
+pub extern "C" fn quiche_conn_export_keying_material(
+    conn: &Connection, out: *mut u8, out_len: size_t, label: *const u8,
+    label_len: size_t,
+) -> c_int {
+    if out.is_null() || label.is_null() || out_len == 0 || label_len == 0 ||
+        !conn.is_established() {
+        return -1;
+    }
+
+    let output = unsafe { slice::from_raw_parts_mut(out, out_len) };
+    let label = unsafe { slice::from_raw_parts(label, label_len) };
+    if conn.handshake.export_keying_material(output, label) { 0 } else { -1 }
+}
+
+#[repr(C)]
+pub struct OpenSshPrivateKey {
+    kind: u32,
+    private_key: [u8; 32],
+    public_key: [u8; 65],
+    public_key_len: size_t,
+}
+
+#[no_mangle]
+pub extern "C" fn quiche_parse_openssh_private_key(
+    pem: *const u8, pem_len: size_t, passphrase: *const u8,
+    passphrase_len: size_t, out: *mut OpenSshPrivateKey,
+) -> c_int {
+    use ssh_key::private::{EcdsaKeypair, KeypairData};
+
+    if pem.is_null() || out.is_null() || pem_len == 0 || pem_len > 65536 ||
+        passphrase_len > 4096 || (passphrase.is_null() && passphrase_len != 0) {
+        return -1;
+    }
+    unsafe { ptr::write_bytes(out, 0, 1) };
+    let pem = unsafe { slice::from_raw_parts(pem, pem_len) };
+    let Ok(parsed) = ssh_key::PrivateKey::from_openssh(pem) else {
+        return -1;
+    };
+    let key = if parsed.is_encrypted() {
+        if passphrase.is_null() || passphrase_len == 0 { return -1; }
+        let secret = unsafe { slice::from_raw_parts(passphrase, passphrase_len) };
+        let Ok(decrypted) = parsed.decrypt(secret) else { return -1; };
+        decrypted
+    } else {
+        parsed
+    };
+
+    let mut result = OpenSshPrivateKey {
+        kind: 0,
+        private_key: [0; 32],
+        public_key: [0; 65],
+        public_key_len: 0,
+    };
+    match key.key_data() {
+        KeypairData::Ed25519(pair) => {
+            result.kind = 1;
+            result.private_key.copy_from_slice(pair.private.as_ref());
+            result.public_key[..32].copy_from_slice(pair.public.as_ref());
+            result.public_key_len = 32;
+        }
+        KeypairData::Ecdsa(EcdsaKeypair::NistP256 { private, public }) => {
+            let bytes: &[u8] = public.as_ref();
+            if bytes.len() != 65 { return -1; }
+            result.kind = 2;
+            result.private_key.copy_from_slice(private.as_ref());
+            result.public_key.copy_from_slice(bytes);
+            result.public_key_len = 65;
+        }
+        _ => return -2,
+    }
+    unsafe { ptr::write(out, result) };
+    0
+}
+
 #[no_mangle]
